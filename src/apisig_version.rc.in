#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @APISIG_FILE_VERSION@
 PRODUCTVERSION @APISIG_FILE_VERSION@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "apisig project\0"
            VALUE "FileDescription", "apisig API signature tool\0"
            VALUE "FileVersion", "@APISIG_FILE_VERSION_STR@\0"
            VALUE "InternalName", "apisig\0"
            VALUE "OriginalFilename", "apisig.exe\0"
            VALUE "ProductName", "apisig\0"
            VALUE "ProductVersion", "@APISIG_FILE_VERSION_STR@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
